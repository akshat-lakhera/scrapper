# ==========================================
# MarketScout Environment Configuration
# ==========================================

# Active provider: 'local' (offline mock mode) or 'brightdata' (live mode)
SCRAPER_PROVIDER=local

# Bright Data API Credentials (keep secret - never commit to git)
BRIGHTDATA_API_KEY=
BRIGHTDATA_SCRAPER_STUDIO_COLLECTOR_ID=
BRIGHTDATA_SCRAPER_ID=
BRIGHTDATA_PRODUCT_DATASET_ID=
BRIGHTDATA_JOB_DATASET_ID=
BRIGHTDATA_WORKSPACE_ID=
BRIGHTDATA_BASE_URL=https://api.brightdata.com
BRIGHTDATA_SERP_ZONE=serp_api1

# CORS Configuration
FRONTEND_ORIGIN=http://127.0.0.1:8000,http://localhost:5173

# Database URL
DATABASE_URL=sqlite:///./data/marketscout.db

# Groq API (Structured Field Extraction & Normalization)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
