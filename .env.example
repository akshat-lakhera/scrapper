# ==========================================
# MarketScout Environment Configuration
# ==========================================

# Active provider: 'local' (offline mock mode) or 'brightdata' (live mode)
SCRAPER_PROVIDER=local

# Bright Data API Credentials (keep secret - never commit to git)
BRIGHTDATA_API_KEY=
BRIGHTDATA_SCRAPER_ID=
BRIGHTDATA_WORKSPACE_ID=
BRIGHTDATA_BASE_URL=https://api.brightdata.com

# Database URL
DATABASE_URL=sqlite:///./data/marketscout.db
